# Authentication/UI listener. Keep on loopback when Caddy is on the same node.
GATEKEEPER_LISTEN=127.0.0.1:9080

# Management API. Bind to a private VPC address if another instance must push config.
GATEKEEPER_API_LISTEN=127.0.0.1:9081
GATEKEEPER_API_TOKEN=replace-with-a-long-random-management-secret

GATEKEEPER_COOKIE_SECURE=true
GATEKEEPER_MAX_ATTEMPTS=3
GATEKEEPER_SITE_RATE_LIMIT=10
GATEKEEPER_SITE_RATE_WINDOW=10m
GATEKEEPER_IDENTITY_RATE_LIMIT=2
GATEKEEPER_IDENTITY_RATE_WINDOW=10m
GATEKEEPER_IDENTITY_KEY=replace-with-a-long-random-secret
GATEKEEPER_STATE_TIMEOUT=1s
GATEKEEPER_SHUTDOWN_TIMEOUT=15s

GATEKEEPER_STORE=valkey
GATEKEEPER_VALKEY_MODE=cluster
GATEKEEPER_VALKEY_ADDRS=clustercfg.example.memorydb.eu-west-2.amazonaws.com:6379
GATEKEEPER_VALKEY_TLS=true
GATEKEEPER_VALKEY_USERNAME=
GATEKEEPER_VALKEY_PASSWORD=
GATEKEEPER_VALKEY_PREFIX=gatekeeper:
GATEKEEPER_VALKEY_DIAL_TIMEOUT=750ms
GATEKEEPER_VALKEY_READ_TIMEOUT=750ms
GATEKEEPER_VALKEY_WRITE_TIMEOUT=750ms
GATEKEEPER_VALKEY_POOL_TIMEOUT=750ms

GATEKEEPER_SMTP_ADDR=smtp.example.net:587
GATEKEEPER_SMTP_USERNAME=
GATEKEEPER_SMTP_PASSWORD=
GATEKEEPER_SMTP_FROM=gatekeeper@example.com
GATEKEEPER_SMTP_WORKERS=2
GATEKEEPER_SMTP_QUEUE_SIZE=20
GATEKEEPER_SMTP_DELIVERY_TIMEOUT=10s
