[Unit]
Description=Caddy Gatekeeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caddy-gatekeeper
Group=caddy-gatekeeper
EnvironmentFile=/etc/caddy-gatekeeper/gatekeeper.env
ExecStart=/usr/local/bin/caddy-gatekeeper
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
